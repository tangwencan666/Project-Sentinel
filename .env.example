# Recorded Demo requires no credentials. Default Compose never forwards these LLM values.
PUBLIC_DEMO_MODE=true
DEMO_PORT=18082
DEMO_ALLOWED_HOSTS=localhost,127.0.0.1,sentinel-demo
# Local full stack only: compose.live.yaml. Paid calls require explicit opt-in.
LIVE_AI_ENABLED=false
LIVE_PORT=18083
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=2500
AGENT_MAX_STEPS=18
AGENT_MAX_TOOL_CALLS=40
AGENT_TIMEOUT_SECONDS=480
AGENT_MAX_CONTEXT_CHARS=90000
AGENT_MAX_TOTAL_TOKENS=300000
# Optional USD prices; blank means Estimated Cost = Unknown.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
# Local demonstration only. Bind exposed ports to loopback.
